# /etc/systemd/system/pr-review-worker.service
#
#   useradd --system --user-group --home /var/lib/pr-review-worker --shell /usr/sbin/nologin pr-review-worker
#
# --user-group is not optional: without it, whether the pr-review-worker group
# is created at all depends on USERGROUPS_ENAB in /etc/login.defs, and if it is
# not, systemd cannot resolve Group= below and the unit refuses to start.
#   install -m 0755 pr-review-worker /usr/local/bin/
#   install -m 0600 prw.env /etc/pr-review-worker.env
#   systemctl enable --now pr-review-worker
#
# The worker keeps no state outside StateDirectory, so a restart is always safe:
# queued jobs and the per-PR review budget live in the SQLite file.

[Unit]
Description=Automated PR review worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as its own unprivileged account, not root, so a compromised review CLI
# (it executes on contributor-controlled diffs) cannot touch anything outside
# StateDirectory.
User=pr-review-worker
Group=pr-review-worker
ExecStart=/usr/local/bin/pr-review-worker
EnvironmentFile=/etc/pr-review-worker.env
Environment=PRW_DB=/var/lib/pr-review-worker/prw.db
StateDirectory=pr-review-worker
WorkingDirectory=/var/lib/pr-review-worker
Restart=always
RestartSec=5s

# The review CLI runs as a child of this unit; control-group kill makes systemd
# reap the whole tree, matching the worker's own process-group kill policy.
KillMode=control-group
TimeoutStopSec=30s

# Memory ceiling for the box sized in ADR-0001. The review CLI is the heavy
# part; if it exceeds this the job fails and retries rather than the VM
# thrashing.
MemoryMax=3G

NoNewPrivileges=true
# PrivateTmp gives the unit its own /tmp and /var/tmp, discarded on stop, so the
# review CLI's scratch files never touch the host's. ProtectSystem=strict leaves
# the rest of the filesystem read-only; the only writable persistent path is
# StateDirectory, which is where the SQLite file lives.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
