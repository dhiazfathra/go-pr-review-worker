# Copy to .env, fill in, then: set -a && . ./.env && set +a

PRW_ADDR=:8080
PRW_DB=prw.db
PRW_LOG_LEVEL=info

# --- GitHub (both are required to enable it) ---
# Token needs pull_requests: write on the repositories to review.
PRW_GITHUB_TOKEN=
# Must match the secret configured on the webhook. Generate with:
#   openssl rand -hex 32
PRW_GITHUB_WEBHOOK_SECRET=
# PRW_GITHUB_API=https://github.example.com/api/v3
# Endpoints must be https: every request carries the token above. A loopback
# http endpoint is allowed only with PRW_ALLOW_INSECURE_LOOPBACK=true.
# PRW_ALLOW_INSECURE_LOOPBACK=false

# --- GitLab (both are required to enable it) ---
PRW_GITLAB_TOKEN=
PRW_GITLAB_WEBHOOK_SECRET=
# PRW_GITLAB_API=https://gitlab.example.com/api/v4

# --- Review engines ---
PRW_CLAUDE_BIN=claude
PRW_CLAUDE_ARGS="--print --output-format text"
# Forces ANTHROPIC_MODEL for every claude invocation, overriding the account's
# own ~/.claude/settings.json — see docs/incidents/2026-09-02-manual-run-stale-model-alias.md
# PRW_CLAUDE_MODEL=claude-sonnet-5
PRW_OPENCODE_BIN=opencode
PRW_OPENCODE_ARGS=run
PRW_ENGINE_TIMEOUT=10m

# --- Review policy ---
PRW_MAX_CYCLES=2
PRW_MAX_ATTEMPTS=3
PRW_RETRY_DELAY=30s
PRW_POLL_INTERVAL=30s
PRW_MIN_SEVERITY=minor
PRW_MAX_COMMENTS=20
PRW_MAX_FINDINGS=25
PRW_ANNOUNCE_BUDGET_EXHAUSTED=true

# --- Watcher: catches pushes no webhook delivered (worker down, no hook, rotated secret) ---
# Comma-separated provider:owner/name. Empty disables polling entirely.
# PRW_WATCH_REPOS=github:octocat/hello,github:octocat/world
# PRW_WATCH_INTERVAL=2m

# --- Follow-up pass: re-check the worker's own threads against the new commits ---
PRW_VERIFY_REPLIES=true
# Approving can satisfy branch protection and unblock a merge, so it is opt-in.
# The token's account must be able to review the repo and must not be the PR's
# author (GitHub: "422 Can not approve your own pull request"). A refused
# approval is logged and the review still succeeds.
PRW_APPROVE_WHEN_RESOLVED=false
